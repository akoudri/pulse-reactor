<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.janus.pulse</groupId>
        <artifactId>pulse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pulse-loadtest</artifactId>
    <name>Pulse Load Test</name>
    <description>Différentiel de charge Gatling (DSL Java) : réactif (8080) vs jumeau MVC+Loom (8081).</description>

    <properties>
        <!-- Versions Gatling hors BOM Spring : pinnées ici. Paire compatible (plugin 4.x +
             gatling core 3.13.x). À reconfirmer/bumper via context7/web avant un vrai tir. -->
        <gatling.version>3.13.0</gatling.version>
        <gatling-maven-plugin.version>4.13.0</gatling-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- DSL Java + moteur Gatling (apporte gatling-core-java / gatling-http-java).
             Scope test : la simulation vit dans src/test/java. -->
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin Gatling SANS liaison de phase : `mvn verify` compile la simulation
                 mais ne la LANCE PAS. Le tir se fait explicitement via `mvn gatling:test`
                 (voir README.md), une fois les deux apps + l'upstream-sim démarrés. -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
