<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.janus.pulse</groupId>
        <artifactId>pulse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pulse-reactive</artifactId>
    <name>Pulse Reactive</name>
    <description>API réactive : WebFlux + Reactor (port 8080). Jumeau réactif du différentiel.</description>

    <properties>
        <!-- Resilience4j hors BOM Boot : version pinnée (2.x compatible Reactor 3.x). -->
        <resilience4j.version>2.3.0</resilience4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>fr.janus.pulse</groupId>
            <artifactId>pulse-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- WebFlux : serveur réactif (Netty) + Reactor. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- WebClient : en Boot 4 l'auto-config (WebClient.Builder prototype) est dans ce
             module dédié, non transitif depuis starter-webflux. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webclient</artifactId>
        </dependency>
        <!-- Bean Validation pour @Valid @RequestBody (apporte Hibernate Validator). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Observabilité (lab J3-2 D) : Actuator + registry Prometheus → /actuator/prometheus.
             Métriques d'ingestion / agrégation / ouvertures de circuit via Micrometer.
             NB tracing : on ne branche PAS de bridge Micrometer Tracing (brave/otel) ici — il
             instrumenterait aussi HTTP et écraserait le traceId custom du lab J3-1 dans le MDC.
             On réutilise la propagation de contexte de J3-1 (même clé traceId + accessor) pour
             corréler la frontière Kafka → pipeline → push SSE ; un bridge se grefferait sur la
             même SPI context-propagation sans changer le code applicatif. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Persistance réactive : Spring Data R2DBC (DatabaseClient, R2dbcRepository,
             R2dbcTransactionManager auto-configuré) + driver R2DBC Postgres. Versions
             via le BOM Boot, on ne pinne rien. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-r2dbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
        </dependency>

        <!-- Ingestion Kafka (lab J3-2 A) : le client Kafka Java est bloquant par nature,
             on le bridge en Flux via un Sinks (PAS de reactor-kafka, discontinué en mai 2025).
             En Boot 4 l'auto-configuration Kafka (ProducerFactory, KafkaTemplate, container
             factory) vit dans le module dédié `spring-boot-kafka` — `spring-kafka` seul
             n'apporte que la lib, pas les beans auto-configurés (même logique que
             `spring-boot-webclient`). Version via le BOM, alignée Jackson 3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- Résilience (lab J3-2 C). Le natif Spring Framework 7 (@Retryable sur retour
             réactif, circuit breaker des Interface Clients) est privilégié quand on contrôle
             le client ; ici on garde un WebClient direct et on utilise les opérateurs Reactor
             de Resilience4j (transformDeferred(CircuitBreakerOperator/BulkheadOperator)). Hors
             BOM Boot → versions pinnées. On n'ajoute PAS le starter Boot R4J (auto-config non
             alignée Boot 4) : beans créés explicitement, config visible. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-bulkhead</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- Propagation de contexte (Partie D) : SPI Micrometer qui ponte le Context
             Reactor et les ThreadLocal (MDC). Requis par
             Hooks.enableAutomaticContextPropagation(). Version via le BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Slice test WebFlux (lab J4-1 B) : en Boot 4 le slice @WebFluxTest a été sorti de
             spring-boot-test-autoconfigure vers un module dédié `spring-boot-webflux-test`
             (package org.springframework.boot.webflux.test.autoconfigure), non transitif via
             starter-test — même logique de modularisation que spring-boot-webclient. Apporte
             aussi l'auto-config WebTestClient pour le slice. Version via le BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Intégration Testcontainers ↔ Boot (lab J4-1 C) : fournit @ServiceConnection, qui
             génère les ConnectionDetails (R2DBC, Kafka…) à partir d'un bean container, en
             remplacement de @DynamicPropertySource. Version via le BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x (BOM Boot) : PostgreSQL éphémère pour les tests d'intégration
             R2DBC (pas de base partagée). En TC 2.0 les modules sont préfixés
             `testcontainers-*` (jadis `org.testcontainers:postgresql`). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pont R2DBC de Testcontainers (classe org.testcontainers.r2dbc.R2DBCDatabaseContainer)
             requis par la ConnectionDetailsFactory R2DBC de Boot pour dériver les
             ConnectionFactoryOptions du PostgreSQLContainer via @ServiceConnection (lab J4-1 C).
             Sans lui : NoClassDefFoundError R2DBCDatabaseContainer au démarrage du contexte.
             Version gérée par le BOM Testcontainers (importé par le BOM Boot) — pas de pin. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-r2dbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Kafka éphémère (image apache/kafka, KRaft) pour les tests d'intégration de
             l'ingestion. En TC 2.x : module `testcontainers-kafka`, classe
             `org.testcontainers.kafka.KafkaContainer` (supporte apache/kafka). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Utilitaires de test spring-kafka (ContainerTestUtils.waitForAssignment) pour
             attendre l'assignation de partition avant de produire → test déterministe. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- BlockHound (lab J4-1 D) : agent qui instrumente la JVM pour détecter tout appel
             bloquant exécuté sur un thread « non bloquant » (event-loop Netty, schedulers
             parallel/single de Reactor). Hors BOM Boot → version pinnée. On prend la dernière
             (1.0.16) : l'instrumentation est sensible au JDK et on tourne sous JDK 25 ; le
             byte-buddy sous-jacent est aligné par le BOM (1.17.x, compatible JDK 25). Le module
             `-junit-platform` auto-installe BlockHound via un LauncherSessionListener (ServiceLoader)
             pour toute la session de test — pas d'appel BlockHound.install() manuel. -->
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound-junit-platform</artifactId>
            <version>1.0.16.RELEASE</version>
            <scope>test</scope>
        </dependency>
        <!-- WireMock pour stubber les upstreams du fan-out (hors BOM → version pinnée).
             Variante "standalone" : Jetty/Jackson shadés, évite les conflits avec Netty. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- BlockHound (lab J4-1 D) sous JDK >= 13 : son auto-test d'instrumentation
                 (redéfinition de Thread.sleep & co.) échoue ("The instrumentation have failed")
                 sans ce flag. Indispensable sous JDK 25. C'est une option de la JVM de test
                 (config de plugin), pas un pin de version de dépendance. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+AllowRedefinitionToAddDeleteMethods</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
